{
  "name": "butterfly-ui",
  "version": "0.2.0",
  "private": true,
  "description": "ACMP · Butterfly Eye View: a standalone action → consequence explorer across ten worlds",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "next build",
    "start": "next start -p 3020",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test \".test-build/tests/*.test.js\"",
    "postinstall": "node scripts/copy-cesium.mjs && node scripts/copy-havok.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.33.1",
    "@babylonjs/havok": "1.3.14",
    "cesium": "1.138.0",
    "matter-js": "^0.20.0",
    "next": "16.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/matter-js": "^0.19.8",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
